		{"id":"e1","type":"text","x":680,"y":1230,"width":300,"height":50,"color":"5","text":"**E1 Eval 体系**\ngolden set · CI 门禁 · 对抗集 · judge 校准"},
		{"id":"e2","type":"text","x":680,"y":1290,"width":300,"height":50,"color":"5","text":"**E2 可观测性**\ntrace/span 打点 · 必打字段 · 漂移监控"},
